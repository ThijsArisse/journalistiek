    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 22
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "H\xE9! Ja, heel graag! Wat zou je graag willen spelen? \n\nWe kunnen bijvoorbeeld:\n\n*  
    **Snelle dobbelspelletjes:**  Simpel maar leuk.\n*   **Korte verhalen:** We schrijven
    een verhaal op elkaar.\n*   **Een woordspel:**  Ik geef je een woord, jij moet
    een woord op dezelfde lijn bedenken.\n*   **Een rollenspel:**  We kunnen fantasie
    maken en een spel spelen.\n\nWat vind je leuk?  Of heb je nog een ander idee?
    \U0001F60A"
